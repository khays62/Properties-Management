# Local development defaults. Set production values in Render, not in this file.
# Generate a local secret with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=Africa/Mogadishu

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=False
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL only. Render supplies DATABASE_URL; local development can use
# the split settings below. Leave DATABASE_URL blank locally.
DATABASE_URL=
POSTGRES_DB=omniproperties
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

STATIC_URL=/static/
STATIC_ROOT=staticfiles
MEDIA_URL=/media/
MEDIA_ROOT=media
MEDIA_STORAGE_BACKEND=filesystem

# Configure these for production S3-compatible media storage.
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT_URL=
AWS_QUERYSTRING_EXPIRE=300

# SMTP settings. Render production requires verified Resend sender/domain
# settings and a secret EMAIL_HOST_PASSWORD supplied in the Render dashboard.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=resend
EMAIL_HOST_PASSWORD=<resend-smtp-credential>
DEFAULT_FROM_EMAIL=noreply@your-verified-domain.com
FRONTEND_BASE_URL=http://localhost:5173
PASSWORD_RESET_TIMEOUT=86400

# Local HTTP defaults. Production must enable HTTPS and secure cookies.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
SECURE_CONTENT_TYPE_NOSNIFF=True
SECURE_REFERRER_POLICY=strict-origin-when-cross-origin
SECURE_PROXY_SSL_HEADER=
